rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: uid, displayName, email, photoURL, role, teamId, position, points, level, badges, skills, completedTasks, activityLevel, createdAt
    //
    // Collection: teams
    // Fields: id, name, mission, department, contactEmail, memberCount
    //
    // Collection: roles
    // Fields: id, teamId, title, description, responsibilities, skillsRequired, commitment, difficulty, isOpen
    //
    // Collection: tasks
    // Fields: id, title, description, points, deadline, assignedMemberIds, teamId, status
    //
    // Collection: announcements
    // Fields: id, title, content, authorId, createdAt
    //
    // Collection: applications
    // Fields: id, userId, roleId, status, motivation, createdAt
    //
    // Collection: events
    // Fields: id, title, description, startDate, endDate, time, location, type, imageUrl
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAssignedToTask() {
      return isAuthenticated() && 
        ('assignedMemberIds' in resource.data && request.auth.uid in resource.data.assignedMemberIds);
    }
    
    function isBoard() {
      return isAuthenticated() && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'management'] ||
         request.auth.token.email in ["diogomaioedu@gmail.com", "andremarquesmaio@gmail.com", "best.almada@best-eu.org"]);
    }

    function isAdmin() {
      return isAuthenticated() && 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.email in ["diogomaioedu@gmail.com", "andremarquesmaio@gmail.com", "best.almada@best-eu.org"]);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email']) &&
             data.uid is string &&
             data.displayName is string && data.displayName.size() < 100 &&
             data.email is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isBoard() || isOwner(userId);
    }

    match /notifications/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); // Allow users to trigger notifications or restricted? 
      // Actually, createNotification in App.tsx is used by anyone who can trigger the action.
      // Better:
      allow write: if isAuthenticated(); 
    }

    match /metas/{metaId} {
      allow read: if isAuthenticated();
      allow write: if isBoard();
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isBoard();
    }

    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isBoard();
    }

    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isBoard();
      allow update: if isBoard() || (isAssignedToTask() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
      allow delete: if isBoard();
    }

    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isBoard();
    }

    match /glossary/{termId} {
      allow read: if isAuthenticated();
      allow write: if isBoard();
    }

    match /applications/{applicationId} {
      allow read: if isBoard() || isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isBoard();
      allow delete: if isBoard() || isOwner(resource.data.userId);
    }

    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isBoard();
    }

    match /gadgets/{gadgetId} {
      allow read: if isAuthenticated();
      allow write: if isBoard();
    }

    match /achievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if isBoard();
    }

    match /families/{familyId} {
      allow read: if isAuthenticated();
      allow write: if isBoard();
    }

    match /socialBodies/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isBoard();
    }

    match /meetings/{meetingId} {
      allow read: if isAuthenticated();
      allow write: if isBoard();
    }

    match /appContent/{contentId} {
      allow read: if isAuthenticated();
      allow write: if isBoard();
    }
  }
}
