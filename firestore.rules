rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isStaff() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'management'];
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(uid);
      allow update: if isSignedIn() && (isOwner(uid) || isStaff());
      allow delete: if isStaff();
    }

    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /applications/{applicationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /gadgets/{gadgetId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /achievements/{achievementId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /families/{familyId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /socialBodies/{memberId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /appContent/{contentId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /glossary/{termId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /metas/{metaId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }
  }
}
