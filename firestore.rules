rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isStaff() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'management'];
    }

    // Collection Security Rules

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isOwner(uid) && (!('role' in request.resource.data) || request.resource.data.role == 'baby');
      allow update: if isSignedIn() && (
        isStaff() || 
        (isOwner(uid) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role))
      );
      allow delete: if isStaff();
    }

    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update: if isStaff() || (
        isSignedIn() && 
        (request.auth.uid in resource.data.assignedMemberIds || request.auth.uid == resource.data.coordinatorId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );
      allow delete: if isStaff();
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /applications/{applicationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /gadgets/{gadgetId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /achievements/{achievementId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /families/{familyId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /socialBodies/{memberId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /appContent/{contentId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /glossary/{termId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /metas/{metaId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /meetings/{meetingId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      // Allow creation by staff
      allow create: if isStaff();
      allow update: if isSignedIn() && (
        isStaff() || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
      );
      allow delete: if isStaff();
    }
  }
}
